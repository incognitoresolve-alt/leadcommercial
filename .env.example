# Copier ce fichier en `.env` et remplir les valeurs avant de lancer `npm start`.

# Cle Web3Forms : declenche un email a chaque nouveau lead.
# Celle du projet Boussole Prevoyance (OVB) est deja fonctionnelle et route vers
# la meme boite mail -- la reprendre telle quelle pour garder un seul flux de leads.
WEB3FORMS_KEY=

# Token protegeant /admin.html (liste des leads) et l'export CSV.
ADMIN_TOKEN=change-moi
